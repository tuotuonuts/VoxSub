# Python
__pycache__/
*.py[cod]
.venv/
.venv.invalid-*/
*.egg-info/
.pytest_cache/
/.pytest-*/

# 本地硬件探针 / 冒烟测试临时目录
/.npu-probe/
/.npu-run-*/
/.smoke-*/

# 构建产物
build/
dist/
/Release/
*.spec
# 例外：手写的打包配置要入库（自动生成的才忽略）
!frontend/backend/ipc_server.spec

# 运行时数据（模型/下载缓存不入库）
models/
downloads/
diagnostics/

# 凭据与本地配置
.env
*.env
config.local.json
*.sentry.local
sentry_dsn.txt
sentry_auth_token.txt
sentry_api.json

# 个人本地辅助脚本（可能包含通知账号配置，不公开）
scripts/qq_notify.py

# IDE / OS
.idea/
.vscode/
*.log
.DS_Store
Thumbs.db

# 并行开发环境（1.1GB，绝不应入库）
.venv-codex/
.venv.invalid-*/

# 前端依赖与产物
frontend/node_modules/
frontend/dist/
frontend/logs/

# 启动器日志
logs/

# PyInstaller 中间产物与 sidecar 输出
frontend/backend/build/
frontend/backend/dist/
*.spec.bak

# electron-builder 输出
frontend/release/
