{
  "name": "voxsub-electron",
  "version": "0.9.0-beta",
  "private": true,
  "description": "语幕 VoxSub — Electron 前端（IPC 接 Python 核心）",
  "main": "dist/main/main.js",
  "scripts": {
    "prebuild": "node scripts/sanitize.mjs",
    "build:main": "esbuild src/main/main.ts src/main/preload.ts src/main/backend.ts src/main/capture.ts --bundle --platform=node --target=node20 --external:electron --outdir=dist/main",
    "build:renderer": "esbuild src/renderer/index.ts src/renderer/overlay.ts src/renderer/selector.ts src/renderer/ocr-overlay.ts --bundle --format=iife --target=chrome120 --external:electron --outdir=dist/renderer",
    "build:assets": "node scripts/copy-assets.mjs",
    "build": "npm run build:main && npm run build:renderer && npm run build:assets",
    "typecheck": "tsc --noEmit",
    "verify:palette": "node tools/verify-palette.mjs",
    "test:session-timeline": "node tools/test-session-timeline.mjs",
    "test:backend-status": "node tools/test-backend-status.mjs",
    "test:window-lifecycle": "node tools/test-window-lifecycle.mjs",
    "test:log-time": "node tools/test-log-time.mjs",
    "test:main-quit-guard": "node tools/test-main-quit-guard.mjs",
    "test:migration-takeover": "node tools/test-migration-takeover.mjs",
    "test:backend-command-result": "node tools/test-backend-command-result.mjs",
    "test:request-outcome": "node tools/test-request-outcome.mjs",
    "test:page-lifecycle": "node tools/test-page-lifecycle.mjs",
    "test:migration-cleanup": "node tools/test-migration-cleanup.mjs",
    "test:catalog-races": "node tools/test-catalog-races.mjs",
    "test:overlay-opacity": "node tools/test-overlay-opacity.mjs",
    "test:acceptance-contracts": "node tools/test-acceptance-contracts.mjs && node tools/test-acceptance-contracts-self.mjs",
    "test:recording-control": "node tools/test-recording-control.mjs && node tools/test-mode-recording.mjs",
    "test:logic": "npm run test:recording-control && npm run test:window-lifecycle && npm run test:log-time && npm run test:language-selection && npm run test:language-capabilities && npm run test:overlay-opacity && npm run test:session-timeline && npm run test:backend-status && npm run test:main-quit-guard && npm run test:migration-takeover && npm run test:backend-command-result && npm run test:request-outcome && npm run test:page-lifecycle && npm run test:migration-cleanup && npm run test:catalog-races && npm run test:ui-components && npm run test:progress-bar && npm run test:confirm-action && npm run test:status-row && npm run test:page-dispose",
    "check": "npm run typecheck && npm run verify:palette && npm run test:logic && npm run test:diagnostics-observability && npm run test:command-feedback && npm run test:shared-ui && npm run test:shortcuts",
    "start": "npm run build && electron .",
    "watch": "esbuild src/renderer/index.ts src/renderer/overlay.ts src/renderer/selector.ts src/renderer/ocr-overlay.ts --bundle --format=iife --target=chrome120 --external:electron --outdir=dist/renderer --watch",
    "probe:backend": "python tools/probe-backend.py",
    "smoke:ui": "node tools/smoke-ui.mjs",
    "verify:features": "python tools/compare-qt-features.py",
    "test:ocr": "python tools/test-ocr-e2e.py",
    "i18n:add": "python tools/add-i18n-entries.py",
    "i18n:page-back": "python tools/i18n-page-back.py",
    "verify": "npm run check && npm run probe:backend && npm run test:ocr && npm run test:migration",
    "test:migration": "python tools/test-migration.py",
    "i18n:migration": "python tools/i18n-migration.py",
    "check:uninstaller": "python tools/check-uninstaller-risk.py",
    "launch": "node scripts/launch.mjs",
    "launch:clean": "node scripts/launch.mjs --clean",
    "launch:dev": "node scripts/launch.mjs --dev",
    "launch:debug": "node scripts/launch.mjs --debug",
    "probe:resize": "node tools/probe-resize.mjs",
    "css:px2rem": "python tools/px-to-rem.py",
    "launch:silent": "node scripts/launch.mjs --silent --debug",
    "build:backend": "python ../.venv/Scripts/pyinstaller-run.py",
    "package": "npm run build && electron-builder --config electron-builder.config.cjs --win --x64",
    "package:dir": "npm run build && electron-builder --config electron-builder.config.cjs --win --x64 --dir",
    "verify:packaged": "python tools/verify-packaged.py",
    "test:reported": "node tools/test-reported-fixes.mjs",
    "test:icon": "electron tools/test-icon.cjs",
    "test:overlay-menus": "node tools/test-overlay-menus.mjs",
    "test:recorder": "node tools/test-recorder-controls.mjs",
    "test:launchers": "node tools/test-launchers.mjs",
    "test:launcher-cleanup": "node tools/test-launcher-cleanup.mjs",
    "test:launcher-e2e": "node tools/test-launcher-cleanup-e2e.mjs",
    "test:overlay-display": "node tools/test-overlay-display-mode.mjs",
    "test:session": "node tools/test-session-controls.mjs",
    "test:tuning-lock": "node tools/test-tuning-lock.mjs",
    "test:log-levels": "node tools/test-log-levels.mjs",
    "test:translate-tiers": "node tools/test-translate-tiers.mjs",
    "test:language-selection": "node tools/test-language-selection.mjs",
    "test:overlay-sentence": "node tools/test-overlay-current-sentence.mjs",
    "test:launcher-debug-args": "node tools/test-launcher-debug-args.mjs",
    "test:ui-components": "node tools/test-ui-components.mjs",
    "test:progress-bar": "node tools/test-progress-bar.mjs",
    "test:confirm-action": "node tools/test-confirm-action.mjs",
    "test:page-dispose": "node tools/test-page-dispose.mjs",
    "test:status-row": "node tools/test-status-row.mjs",
    "test:language-capabilities": "node tools/test-language-capabilities.mjs",
    "test:diagnostics-observability": "node tools/test-diagnostics-observability.mjs",
    "test:command-feedback": "node tools/test-command-feedback.mjs",
    "test:shared-ui": "node tools/test-shared-ui.mjs",
    "test:shortcuts": "node tools/test-shortcuts.mjs && node tools/test-shortcut-ui.mjs && node tools/test-shortcut-main.mjs"
  },
  "devDependencies": {
    "@types/node": "22.13.1",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.25.0",
    "typescript": "5.7.3"
  }
}
